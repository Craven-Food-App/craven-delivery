{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "verify:stripe": "tsx scripts/verify-stripe-setup.ts",
    "test:payments": "tsx scripts/test-payment-flow.ts",
    "validate:env": "tsx scripts/validate-env.ts",
    "dev": "npx vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm:dev\" \"npm:dev:server\"",
    "build": "npx vite build",
    "build:dev": "npx vite build --mode development",
    "build:prod": "npx vite build --mode production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "preview": "npx vite preview",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "cap:sync": "cap sync",
    "cap:build:ios": "cap build ios",
    "cap:build:android": "cap build android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:run:ios": "cap run ios",
    "cap:run:android": "cap run android",
    "feeder:sync": "node -e \"const fs=require('fs');fs.copyFileSync('apps/feeder/capacitor.config.ts','capacitor.config.temp.ts');\" && npx cap sync && node -e \"const fs=require('fs');fs.unlinkSync('capacitor.config.temp.ts');\"",
    "feeder:open:android": "node -e \"const fs=require('fs');fs.copyFileSync('apps/feeder/capacitor.config.ts','capacitor.config.temp.ts');\" && npx cap open android && node -e \"const fs=require('fs');if(fs.existsSync('capacitor.config.temp.ts'))fs.unlinkSync('capacitor.config.temp.ts');\"",
    "feeder:open:ios": "node -e \"const fs=require('fs');fs.copyFileSync('apps/feeder/capacitor.config.ts','capacitor.config.temp.ts');\" && npx cap open ios && node -e \"const fs=require('fs');if(fs.existsSync('capacitor.config.temp.ts'))fs.unlinkSync('capacitor.config.temp.ts');\"",
    "feeder:build": "npm run build && npm run feeder:sync",
    "customer:dev": "cd apps/customer && npm run dev",
    "customer:build": "cd apps/customer && npm run build",
    "customer:add:android": "cd apps/customer && npx cap add android && cd ../..",
    "customer:add:ios": "cd apps/customer && npx cap add ios && cd ../..",
    "customer:sync": "cd apps/customer && npm run sync",
    "customer:open:android": "cd apps/customer && npm run open:android",
    "customer:open:ios": "cd apps/customer && npm run open:ios",
    "customer:build:sync": "cd apps/customer && npm run build && npm run sync",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "performance:lighthouse": "echo 'Lighthouse CI not configured'",
    "performance:budget": "bundlesize",
    "analyze": "vite-bundle-analyzer",
    "clean": "rm -rf dist node_modules/.vite",
    "postinstall": "cd apps/feeder && cap sync",
    "load:pre-incorporation-template": "tsx scripts/load-pre-incorporation-template.ts",
    "reset-exec-password": "tsx scripts/reset-executive-password.ts",
    "cleanup:report": "tsx scripts/cleanup-codebase.ts",
    "git:push": "pwsh -File git-push.ps1",
    "push": "pwsh -File git-push.ps1",
    "tablet:dev": "cd apps/tablet && npm run dev",
    "tablet:build": "cd apps/tablet && npm run build",
    "tablet:sync": "cd apps/tablet && npm run sync",
    "tablet:open:android": "cd apps/tablet && npm run open:android"
  },
