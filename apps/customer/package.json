{
    "name": "@craven/customer",
    "version": "1.2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --config vite.config.ts",
        "build": "vite build --config vite.config.ts",
        "build:capacitor": "vite build --config vite.config.ts --mode capacitor",
        "preview": "vite preview --config vite.config.ts",
        "sync": "npx cap sync",
        "open:android": "npx cap open android",
        "open:ios": "npx cap open ios",
        "sync:android": "npm run build:capacitor && npx cap sync android",
        "sync:ios": "npm run build:capacitor && npx cap sync ios",
        "run:ios": "npm run build:capacitor && npx cap run ios",
        "run:android": "npm run build:capacitor && npx cap run android"
    },
    "dependencies": {
        "@capacitor/android": "^7.4.3",
        "@capacitor/core": "^7.4.3",
        "@capacitor/geolocation": "^7.1.7",
        "@capacitor/haptics": "^7.0.5",
        "@capacitor/ios": "^7.4.3",
        "@capacitor/local-notifications": "^7.0.4",
        "@capacitor/push-notifications": "^7.0.3",
        "@mantine/carousel": "^8.3.8",
        "@mantine/core": "^8.3.8",
        "@mantine/dates": "^8.3.8",
        "@mantine/hooks": "^8.3.8",
        "@mantine/modals": "^8.3.8",
        "@mantine/notifications": "^8.3.8",
        "@mapbox/mapbox-gl-draw": "^1.5.0",
        "@mui/icons-material": "^7.3.5",
        "@mui/material": "^7.3.5",
        "@stripe/react-stripe-js": "^5.4.1",
        "@stripe/stripe-js": "^8.6.1",
        "@supabase/supabase-js": "^2.57.2",
        "@tanstack/react-query": "^5.56.2",
        "dayjs": "^1.11.19",
        "mapbox-gl": "^3.16.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.26.2"
    },
    "devDependencies": {
        "@capacitor/cli": "^7.4.3",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react-swc": "^3.5.0",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.47",
        "tailwindcss": "^3.4.11",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5.5.3",
        "vite": "^7.1.12"
    }
}
